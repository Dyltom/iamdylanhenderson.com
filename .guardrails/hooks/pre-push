#!/bin/sh
if [ ! -t 0 ]; then
  seen=0
  pushing=0
  while read -r local_ref local_sha remote_ref remote_sha; do
    seen=1
    case "$local_sha" in *[!0]*) pushing=1 ;; esac
  done
  [ "$seen" = 0 ] || [ "$pushing" = 1 ] || exit 0
fi
cd "$(git rev-parse --show-toplevel)" || exit 1
unset $(git rev-parse --local-env-vars)
base="$(git merge-base HEAD origin/HEAD 2>/dev/null || git merge-base HEAD origin/main 2>/dev/null)"
if [ -z "$base" ]; then
  echo "pre-push: no merge base with origin/HEAD or origin/main; run git fetch origin" >&2
  exit 1
fi
export GUARDRAILS_BASE="$base" NO_COMMENTS_BASE="$base"
failed=""
check() {
  label="$1"
  dir="$2"
  shift 2
  echo "pre-push: $label"
  (cd "$dir" && "$@") || failed="$failed
  - $label"
}
check "harness" . bun .guardrails/harness.js
check "no-comments" . bun .guardrails/no-comments.js .
check "tamper" . bun .guardrails/tamper.js
check "lockfile" . bun .guardrails/lockfile.js
check "lint-ratchet" . bun .guardrails/ratchet.js
check "lint, typecheck, unit tests" . bun .guardrails/verify.js --skip-missing --related lint typecheck test
if [ -n "$failed" ]; then
  echo "pre-push blocked; these checks fail locally and would fail in CI:$failed" >&2
  exit 1
fi
echo "pre-push: all checks passed"
